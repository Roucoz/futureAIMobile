# Environment Configuration (informational — endpoints are baked into
# src/config/env.ts / env.target.ts; there is no dotenv runtime loader).
#
# Published apps + local dev targets:
#   prod   → "Tuxon"     (com.tuxon.app)  → https://api.tuxon.ai
#   dev    → "Tuxon Dev" (com.tuxon.dev)  → https://dev-api.tuxon.ai
#   local  → local backend                → http://localhost:4010 (debug only)
#
# Switch the target with:
#   npm run target:prod    # store release (default)
#   npm run target:dev     # dev store release
#   npm run target:local   # point Metro/debug at your local backend
#
# Metro / debug builds use 'dev' by default; run `npm run target:local` and
# reload to hit your machine instead.

# Production backend
API_BASE_URL=https://api.tuxon.ai
WS_URL=wss://api.tuxon.ai

# Dev/staging backend
# API_BASE_URL=https://dev-api.tuxon.ai
# WS_URL=wss://dev-api.tuxon.ai

# Local backend (debug only — adjust host for your setup)
#   iOS simulator:     http://localhost:4010
#   Android emulator:  http://10.0.2.2:4010
#   Physical device:   http://<your-computer-LAN-IP>:4010
# API_BASE_URL=http://localhost:4010
# WS_URL=ws://localhost:4010
